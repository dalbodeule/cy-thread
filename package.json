{
  "name": "cy-thread",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:worker": "npm run build && wrangler dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "db:generate": "drizzle-kit generate",
    "db:create": "wrangler d1 create community",
    "db:migrate:local": "wrangler d1 migrations apply community --local",
    "db:seed:local": "wrangler d1 execute community --local --file=./server/db/seed-local.sql",
    "db:migrate:remote": "wrangler d1 migrations apply community --remote",
    "db:backup:remote": "wrangler d1 export community --remote --output=./community-backup.sql",
    "format": "prettier --write .",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@toast-ui/editor": "^3.2.2",
    "@toast-ui/editor-plugin-code-syntax-highlight": "^3.1.0",
    "@toast-ui/editor-plugin-table-merged-cell": "^3.1.0",
    "drizzle-orm": "^0.45.3",
    "nuxt": "^4.5.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxtjs/robots": "^6.2.3",
    "@nuxtjs/sitemap": "^8.5.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@nuxtjs/turnstile": "^1.1.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "@pinia/nuxt": "^1.0.2",
    "prettier": "^3.9.6",
    "@types/node": "^26.6.2",
    "@vueuse/nuxt": "^15.0.0",
    "dayjs-nuxt": "^2.1.11",
    "drizzle-kit": "^0.31.11",
    "nuxt-auth-utils": "^0.5.30",
    "pinia-plugin-persistedstate": "^4.7.1",
    "wrangler": "^4.136.1"
  }
}
