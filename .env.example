# Generate a random value with at least 32 characters for local session signing.
NUXT_SESSION_PASSWORD=replace-with-a-long-random-secret
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=

NUXT_OAUTH_CHZZK_CLIENT_ID=
NUXT_OAUTH_CHZZK_CLIENT_SECRET=
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# Wrangler [vars] MAIL_FROM_ADDRESS defaults to webmaster@mori.space.
